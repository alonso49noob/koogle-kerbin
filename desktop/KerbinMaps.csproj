<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KerbinMaps</RootNamespace>
    <AssemblyName>KoogleKerbin</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Product>Koogle Kerbin</Product>
    <AssemblyTitle>Koogle Kerbin</AssemblyTitle>
    <Description>Visor de superficie y órbitas de Kerbin (KSP stock)</Description>
    <Version>1.6.11</Version>
    <!-- WFO1000 is about the forms designer, which isn't used here: the interface is built in code -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationIcon Condition="Exists('assets\app.ico')">assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The maps and catalogs go in a data/ folder next to the .exe, as in the web
       version: they can be changed without recompiling. Test images don't. -->
  <ItemGroup>
    <None Include="..\data\**\*" Exclude="..\data\test-*;..\data\_tmp*" LinkBase="data"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="license.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY.md" Link="THIRD-PARTY.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\tiles\LEEME.txt" Link="tiles\LEEME.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The logo in the sidebar header. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\app.png" LogicalName="app.png" />
  </ItemGroup>

  <!-- The installer is a separate program (installer/construir.ps1), not part of the app. -->
  <ItemGroup>
    <Compile Remove="installer\**" />
    <None Remove="installer\**" />
  </ItemGroup>

</Project>
